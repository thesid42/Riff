# Local application. Never prefix secrets with VITE_.
PORT=3001
DATABASE_PATH=.data/riff.sqlite

# Configuring a provider does not start it or send a request.
# Liquid: explicitly set a running local/hosted OpenAI-compatible LFM server.
LIQUID_BASE_URL=
LIQUID_MODEL=lfm2.5-1.2b-instruct
LIQUID_API_KEY=

# The event's Tinybird resource links to RawTree. These are separate adapters.
ANALYTICS_PROVIDER=rawtree
RAWTREE_API_KEY=
RAWTREE_BASE_URL=https://api.rawtree.com
RAWTREE_DATABASE=default
RAWTREE_TABLE=campaign_events

# Alternative: select ANALYTICS_PROVIDER=tinybird and your workspace region.
TINYBIRD_BASE_URL=
TINYBIRD_INGEST_TOKEN=
TINYBIRD_READ_TOKEN=
TINYBIRD_DATASOURCE=campaign_events
TINYBIRD_METRICS_PIPE=campaign_metrics

# No image request happens until an explicit future workflow invokes the adapter.
BFL_API_KEY=
BFL_MODEL=flux-2-pro
