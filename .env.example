# Local application. Never prefix secrets with VITE_.
PORT=3001
DATABASE_PATH=.data/riff.sqlite

# Configuring a provider does not start it or send a request.
# Liquid: hosted requests use OpenRouter; local llama.cpp endpoints can override these settings.
LIQUID_BASE_URL=https://openrouter.ai/api/v1
LIQUID_MODEL=liquid/lfm-2.5-2.6b:free
LIQUID_API_KEY=
LIQUID_MAX_TOKENS=4096
LIQUID_TIMEOUT_MS=60000

# The event's Tinybird resource links to RawTree. These are separate adapters.
ANALYTICS_PROVIDER=rawtree
RAWTREE_API_KEY=
RAWTREE_BASE_URL=https://api.rawtree.com
RAWTREE_DATABASE=default
RAWTREE_TABLE=campaign_events

# Experiment loop controls.
# SUCCESS_CLICK_RATE_THRESHOLD stops the automatic loop once a variant reaches this click rate,
# as a fraction from 0 to 1. Clicks here are LLM persona judgments, not human traffic, so this
# default sits far above real-world click-through rates (typically low single-digit percent).
# Do not read it as a realistic advertising benchmark.
SUCCESS_CLICK_RATE_THRESHOLD=0.7
# Largest number of waves the loop will chain on its own before it needs a manual start.
MAX_AUTO_ROUNDS=3
# When a chained round's plan calls for new creative, generate 2-3 BFL images for it. Each such
# round costs one image per headline. Set to false to run the loop on existing media only.
AUTO_CREATIVE_ENABLED=true

# Alternative: select ANALYTICS_PROVIDER=tinybird and your workspace region.
TINYBIRD_BASE_URL=
TINYBIRD_INGEST_TOKEN=
TINYBIRD_READ_TOKEN=
TINYBIRD_DATASOURCE=campaign_events
TINYBIRD_METRICS_PIPE=campaign_metrics

# Image generation runs only after an explicit creative-composer request.
BFL_API_KEY=
BFL_MODEL=flux-2-pro

# Video generation is opt-in and remains unavailable until explicitly enabled.
BFL_VIDEO_ENABLED=false
BFL_VIDEO_MODEL=flux-3-video
